{
  "name": "Gate Automation Live (.NET 8)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:8.0",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "8.0",
      "additionalVersions": []
    }
  },
  "forwardPorts": [5050],
  "portsAttributes": {
    "5050": {
      "label": "Gate Automation API",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.exclude": {
          "**/bin": true,
          "**/obj": true
        }
      }
    }
  },
  "postCreateCommand": "cd GateAutomationLive && dotnet restore",
  "remoteUser": "vscode"
}
